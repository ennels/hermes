# Copy this to .env and fill in your keys
# NEVER commit .env to git

# Alpaca (broker + market data)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper trading to start

# Finnhub (news + sentiment)
FINNHUB_API_KEY=your_finnhub_api_key

# Polygon.io (backup market data)
POLYGON_API_KEY=your_polygon_api_key

# AI Models
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Notifications (Module 6)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
ALERT_PHONE_NUMBER=+1xxxxxxxxxx

SENDGRID_API_KEY=your_sendgrid_api_key
ALERT_EMAIL_FROM=bot@yourdomain.com
ALERT_EMAIL_TO=you@email.com
